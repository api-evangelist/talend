          "docs": "Get all remote engine clusters in the account"
        },
        {
          "info": {
            "name": "Create Remote Engine Cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{region}.cloud.talend.com/processing/runtimes/remote-engine-clusters",
