{
  "opencollection": "1.0.0",
  "info": {
    "name": "Talend Cloud Orchestration Artifacts Tasks API",
    "version": "2021-03"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
