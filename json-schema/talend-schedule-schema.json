{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Schedule",
  "title": "Schedule",
  "type": "object",
  "description": "A time-based trigger for task or plan execution",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone name"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    }
  }
}