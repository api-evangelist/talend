{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PlanCreate",
  "title": "PlanCreate",
  "type": "object",
  "required": [
    "name",
    "workspaceId"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      }
    }
  }
}